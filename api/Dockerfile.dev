# syntax=docker/dockerfile:1
FROM node:26-alpine
ARG TARGETARCH
ENV NODE_ENV=development

WORKDIR /opt/
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=echo-api-npm-${TARGETARCH},target=/root/.npm,sharing=locked \
    npm ci --no-audit --no-fund
ENV PATH=/opt/node_modules/.bin:$PATH

WORKDIR /opt/app
COPY --chown=node:node . .
RUN mkdir -p public/uploads && chown node:node . public public/uploads
USER node

# Develop compiles the server/admin and watches the existing Compose bind paths.
CMD ["node", "/opt/node_modules/@strapi/strapi/bin/strapi.js", "develop"]
